<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET, ACCESS_NETWORK_STATE, FOREGROUND_SERVICE, FOREGROUND_SERVICE_DATA_SYNC and
         POST_NOTIFICATIONS are declared by :core, together with WorkManager's foreground-service
         host: core is what does the networking and runs the sync/download worker. They merge in
         from there — see core/src/main/AndroidManifest.xml. -->

    <!-- In-app updates: hand the downloaded release APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- MODIFY_AUDIO_SETTINGS is declared by :player-core, which owns VolumeBoost. -->

    <!-- Android TV provider writes for Watch Next cards. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!-- Downloads & backup to user-chosen folders (SAF's document picker is absent on most TVs).
         READ stays declared through API 32: dropping it left some OEM builds (TCL Android 12,
         "Permission Shield") with NO grantable storage entry at all — MANAGE_EXTERNAL_STORAGE alone
         is a special app access their settings never surface. With READ declared, requesting it on
         API 30–32 opens the system "Files and media" screen, which also lists
         "Allow management of all files" because MANAGE is declared. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- TV-first app, but allow non-TV installs too: touchscreen optional, and leanback is NOT required
         (required=true blocked plain phones / non-TV armv7a boxes that don't report the leanback feature). -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".OwnTVApp"
        android:allowBackup="false"
        android:banner="@drawable/owntv_banner_eggshell"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/owntv_icon_eggshell"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/owntv_icon_eggshell"
        android:supportsRtl="true"
        android:theme="@style/Theme.OwnTV"
        android:usesCleartextTraffic="true"
        tools:targetApi="26">

        <!-- Exposes the downloaded update APK to the system installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Disable WorkManager default auto-init; OwnTVApp provides Configuration. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- One launcher activity per icon colour (core's AppIcon); AppIconSwitcher keeps exactly one
             enabled. MainActivity is the default (Eggshell) and keeps its name, so an icon placed before this change still
             opens the app. Each carries its own icon, banner and launch-screen theme, and ALL intent
             filters: a disabled activity resolves nothing, so the owntv:// links always reach the enabled
             one. LEANBACK_LAUNCHER shows it on TV launchers; LAUNCHER on phone/tablet/box home screens. -->
        <activity
            android:name=".MainActivityPetrol"
            android:banner="@drawable/owntv_banner_petrol"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/owntv_icon_petrol"
            android:launchMode="singleTop"
            android:roundIcon="@mipmap/owntv_icon_petrol"
            android:theme="@style/Theme.OwnTV.Starting.Petrol"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="play"
                    android:scheme="owntv" />
                <data
                    android:host="open"
                    android:scheme="owntv" />
            </intent-filter>
        </activity>

        <activity
